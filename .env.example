# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# Crossref member login (https://www.crossref.org/documentation/register-members/)
CROSSREF_USERNAME=
CROSSREF_PASSWORD=

# Email address Crossref should list as the depositor of record
CROSSREF_DEPOSIT_EMAIL=

# Where deposits are sent: "sandbox" (test.crossref.org) or "production" (doi.crossref.org).
# Keep this on sandbox until you have reviewed a full batch — registered DOIs are permanent
# and cannot be deleted. Sandbox needs its own separate test.crossref.org credentials.
CROSSREF_ENVIRONMENT=sandbox

# Public base URL of the live site. Crossref resolves each DOI to
# <SITE_BASE_URL>/<article path>, so this must be reachable from the internet —
# localhost will be rejected.
SITE_BASE_URL=https://jurnal-komparativistika.uz
